{
  "name": "qwen-tts-studio",
  "productName": "Qwen TTS Studio",
  "version": "1.0.1",
  "description": "Desktop app for Qwen3-TTS with low VRAM usage",
  "author": "Oatis123",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "fetch-uv": "node scripts/fetch-uv.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/fetch-uv.mjs && electron-vite build && electron-builder --win",
    "release": "node scripts/fetch-uv.mjs && electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "zustand": "5.0.15"
  }
}
